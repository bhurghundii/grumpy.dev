# Copy to .env and adjust as needed.

# --- Postgres (used by docker-compose.yml to configure the `db` service) ---
POSTGRES_USER=grumpy
POSTGRES_PASSWORD=grumpy
POSTGRES_DB=grumpy

# --- App ---
# Note: docker-compose publishes Postgres on host port 5433, not 5432 —
# 5432 is already bound on the reference dev machine. Inside the compose
# network the app talks to the `db` service on its normal internal port
# 5432; this DATABASE_URL (for `make dev`, i.e. running the app locally
# with `uv run` against the dockerized Postgres) uses the published 5433.
DATABASE_URL=postgresql://grumpy:grumpy@localhost:5433/grumpy
LOG_LEVEL=INFO
APP_PORT=8000

# --- Action-facing API ---
# Public URL used to build session_url in POST /sessions responses. Must
# include the scheme, and must be reachable by whoever clicks the link —
# never derived from a request's Host header, since a self-hoster behind a
# proxy would otherwise get a URL that only resolves internally.
GRUMPY_BASE_URL=http://localhost:8000

# Shared bearer token the Action must send as `Authorization: Bearer <token>`
# to POST /sessions and GET /verdict. Generate a real one for anything but
# local dev, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rejected at startup if left as the placeholder below, or if shorter than
# 20 characters — grumpy refuses to start with a token that isn't a real
# secret.
GRUMPY_TOKEN=changeme-generate-a-real-token

# Optional: comma-separated allow-list of repos ('owner/name') permitted to
# use this deployment, e.g. octo/repo-a,octo/repo-b. Unset or blank (the
# default) permits any repo — matches grumpy's current behavior. This is
# defense-in-depth, not the primary access control: GRUMPY_TOKEN is what
# actually gates the API. Set this if you want a leaked or guessed token to
# be unable to create sessions for repos you don't own.
# GRUMPY_ALLOWED_REPOS=

# Optional: a GitHub token with "Commit statuses: write" on the repos grumpy
# gates (a fine-grained personal access token is enough). When set, grumpy
# posts a `grumpy/verdict` commit status on each PR's head commit — pending
# when the session is created, success/failure as soon as the answer is
# graded — and that status is the check to require in branch protection.
# Unset, grumpy posts nothing and the workflow has to gate on GET /verdict
# itself. See INTEGRATION.md.
# GITHUB_STATUS_TOKEN=
# Only for GitHub Enterprise Server, whose API is https://<host>/api/v3.
# GITHUB_API_URL=https://api.github.com

# --- Grading ---
# true selects FakeGrader (passes only if the answer contains the marker
# string "looks-good" — it exists to prove the wiring, not to grade; this
# is how the test suite stays fast and free). false selects RealGrader, a
# two-call grader against the Anthropic Messages API. Required either way,
# no default, same reasoning as GRUMPY_TOKEN above.
FAKE_GRADER=true
# Anthropic API key (https://console.anthropic.com/). Only required when
# FAKE_GRADER=false — also needed to record app/ai/evals/ cassettes (`make eval`).
# MODEL_API_KEY=

# Questions in the paged walkthrough, including the fixed high-level first
# question ("How does this change work on a high level?"). The model writes
# the rest, each anchored to a specific part of the diff and shown on its own
# screen. Default: 5.
# EXAM_QUESTION_COUNT=5

# How many screens must be answered correctly for the session to pass. Each
# screen is graded on submit, leniently (high-level acceptance — a vague or
# partial answer passes as long as nothing in it is wrong), and the session
# fails as soon as reaching this many is no longer possible. Must be between
# 1 and EXAM_QUESTION_COUNT. Default: 3.
# PASSINGMARKS=3

# How many tries a developer gets at a single question before grumpy reveals
# the answer and moves on. A revealed question counts as neither passed nor
# failed — it just can't help reach PASSINGMARKS. 1 means a single try, no
# retries. Skipping a question reveals its answer immediately, the same way.
# Default: 3.
# MAX_QUESTION_ATTEMPTS=3

# Checks that reject a PR at POST /sessions before any question is asked,
# as JSON. The PR gets a 422 with the reason, which the grill job comments
# on the PR before going red. One key per check; omitted keys keep their
# defaults, and unknown keys or bad values fail startup. Today there is one
# check, "size": more than max_changed_lines added + removed lines (context
# doesn't count) in files not matching an exclude glob. 0 turns it off.
# The default, written out:
# EVALUATOR={"size": {"max_changed_lines": 1000, "exclude": ["*.lock", "package-lock.json", "pnpm-lock.yaml", "go.sum"]}}

# Largest diff POST /sessions will accept, in bytes. Default: 400000.
# A larger one is rejected the same way as an EVALUATOR check.
# Bounded by the model's context window, not by Postgres: at roughly 3-4
# bytes per token, 400 KB is ~100k-130k tokens, leaving room for the
# prompts, the response and thinking. Raising it much past this accepts
# diffs that can never be graded — the API rejects the call and the
# developer only ever sees "grading failed".
# MAX_DIFF_BYTES=400000

# Whether a failed mark's note uses the scathing "grumpy" roast persona or a
# direct, professional tone. Off by default (professional) — set true to opt
# into the roast. It never changes whether an answer passed, only the wording.
# true/false.
# MEANIEMODE=false
